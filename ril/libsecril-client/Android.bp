cc_library_shared {
    name: "libsecril-client",
    vendor: true,

    srcs: ["secril-client.cpp"],

    header_libs: ["ril_headers"],

    shared_libs: [
        "libbinder",
        "libcutils",
        "libhardware_legacy",
        "liblog",
        "libutils",
    ],

    // Exynos 4 clients use the extra-volume form of SetCallAudioPath. Select
    // the correct Samsung OEM audio-path numbering for each modem family.
    cflags: [
        "-DRIL_CALL_AUDIO_PATH_EXTRAVOLUME",
        "-Wno-error",
    ] + select(soong_config_variable("samsung_libril", "samsung_libril_modem_type"), {
        "m7450": ["-DSAMSUNG_NEXT_GEN_MODEM"],
        "mdm9x35": ["-DSAMSUNG_NEXT_GEN_MODEM"],
        "ss333": ["-DSAMSUNG_NEXT_GEN_MODEM"],
        "tss310": ["-DSAMSUNG_NEXT_GEN_MODEM"],
        "xmm7260": ["-DSAMSUNG_NEXT_GEN_MODEM"],
        "xmm7450": ["-DSAMSUNG_NEXT_GEN_MODEM"],
        default: [],
    }),
}
