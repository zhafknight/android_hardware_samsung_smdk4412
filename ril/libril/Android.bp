soong_config_module_type {
    name: "samsung_libril_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "samsung_libril",
    variables: ["samsung_libril_modem_type"],
    bool_variables: [
        "build_libril",
        "multi_sim",
        "needs_video_call_field",
        "needs_roaming_protocol_field",
        "needs_ims_type_field",
        "disable_rild_oem_hook",
    ],
    properties: [
        "cflags",
        "enabled",
    ],
}

soong_config_string_variable {
    name: "samsung_libril_modem_type",
    values: [
        "m7450",
        "mdm9x35",
        "ss333",
        "tss310",
        "xmm6260",
        "xmm6262",
        "xmm6360",
        "xmm7260",
        "xmm7450",
    ],
}

samsung_libril_cc_defaults {
    name: "samsung_libril_defaults",

    // BOARD_PROVIDES_LIBRIL / supported modem gating is exported from
    // the device BoardConfig through SOONG_CONFIG_samsung_libril.
    enabled: true,

    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Werror",
        "-DPB_FIELD_32BIT",
    ],

    soong_config_variables: {
        build_libril: {
            enabled: true,
        },
        multi_sim: {
            cflags: [
                "-DANDROID_MULTI_SIM",
                "-DDSDA_RILD1",
                "-DANDROID_SIM_COUNT_2",
            ],
        },
        samsung_libril_modem_type: {
            xmm6262: {
                cflags: [
                    "-DMODEM_TYPE_XMM6262",
                    "-DMODEM_SIM_PIN_FIX",
                ],
            },
            xmm6360: {
                cflags: [
                    "-DMODEM_TYPE_XMM6262",
                    "-DMODEM_TYPE_XMM6360",
                    "-DMODEM_SIM_PIN_FIX",
                ],
            },
            xmm6260: {
                cflags: [
                    "-DMODEM_TYPE_XMM6260",
                    "-DMODEM_SIM_PIN_FIX",
                ],
            },
            m7450: {
                cflags: ["-DSAMSUNG_NEXT_GEN_MODEM"],
            },
            xmm7450: {
                cflags: ["-DSAMSUNG_NEXT_GEN_MODEM"],
            },
            mdm9x35: {
                cflags: ["-DSAMSUNG_NEXT_GEN_MODEM"],
            },
            ss333: {
                cflags: ["-DSAMSUNG_NEXT_GEN_MODEM"],
            },
            tss310: {
                cflags: ["-DSAMSUNG_NEXT_GEN_MODEM"],
            },
            xmm7260: {
                cflags: ["-DSAMSUNG_NEXT_GEN_MODEM"],
            },
            conditions_default: {},
        },
        needs_video_call_field: {
            cflags: ["-DNEEDS_VIDEO_CALL_FIELD"],
        },
        needs_roaming_protocol_field: {
            cflags: ["-DNEEDS_ROAMING_PROTOCOL_FIELD"],
        },
        needs_ims_type_field: {
            cflags: ["-DNEEDS_IMS_TYPE_FIELD"],
        },
        disable_rild_oem_hook: {
            cflags: ["-DOEM_HOOK_DISABLED"],
        },
    },
}

cc_library_shared {
    name: "libril",
    defaults: ["samsung_libril_defaults"],
    vendor: true,

    srcs: [
        "ril.cpp",
        "ril_event.cpp",
        "RilSapSocket.cpp",
        "ril_service.cpp",
        "sap_service.cpp",
    ],

    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libhardware_legacy",
        "librilutils",
        "android.hardware.radio@1.0",
        "android.hardware.radio@1.1",
        "android.hardware.radio@1.2",
        "android.hardware.radio@1.3",
        "android.hardware.radio@1.4",
        "android.hardware.radio@1.5",
        "android.hardware.radio@1.6",
        "android.hardware.radio.deprecated@1.0",
        "libhidlbase",
    ],

    static_libs: [
        "libprotobuf-c-nano-enable_malloc-32bit",
    ],

    local_include_dirs: ["include"],
    include_dirs: ["external/nanopb-c"],
    header_libs: ["samsung_legacy_ril_headers"],
    export_header_lib_headers: ["samsung_legacy_ril_headers"],

    sanitize: {
        integer_overflow: true,
    },
}
