cc_library_shared {
    name: "libUMP",
    vendor: true,
    compile_multilib: "32",
    srcs: [
        "arch_011_udd/ump_frontend.c",
        "arch_011_udd/ump_ref_drv.c",
        "arch_011_udd/ump_arch.c",
        "os/linux/ump_uku.c",
        "os/linux/ump_osu_memory.c",
        "os/linux/ump_osu_locks.c",
    ],
    include_dirs: ["hardware/samsung/exynos4/hal/include"],
    local_include_dirs: ["include"],
    shared_libs: ["liblog", "libcutils"],
    cflags: ["-DLOG_TAG=\"UMP\""],
}
